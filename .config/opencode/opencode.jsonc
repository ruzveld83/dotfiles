{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "gopls": {
      "command": ["gopls", "-rpc.trace", "--debug=:6060", "serve"]
    }
  },
  "plugin": [
    "opencode-gemini-auth@1.4.10",
    "@ex-machina/opencode-anthropic-auth@1.7.5",
    "@dietrichgebert/ponytail@4.8.3",
    "@mohak34/opencode-notifier@v0.2.8"
    // "opencode-claude-auth@latest"
  ],
  "permission": {
    "*": "ask",
    "glob": "allow",
    "grep": "allow",
    "rg": "allow",
    "read": "allow",
    "todowrite": "allow",
    "ls": "allow",
    "head": "allow",
    "find": "allow",
    "echo": "allow",
    "wc": "allow",
    "cat": "allow",
    "context7*": "allow",
    "snoop-doc*": "allow",
    "jetbrains_read*": "allow",
    "jetbrains_search*": "allow"
  },
  "provider": {
    "lm-studio-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio local",
      "options": {
        "baseURL": "http://localhost:1234/v1",
        "apiKey": "lm-studio"
      },
      "models": {
        "qwen2.5-coder-7b-instruct": {
          "name": "qwen2.5-coder-7b-instruct"
        },
        "deepseek/deepseek-r1-0528-qwen3-8b": {
          "name": "deepseek-r1-0528-qwen3-8b"
        },
        "openai/gpt-oss-20b": {
          "name": "gpt-oss-20b"
        },
        "openai/gpt-oss-120b": {
          "name": "gpt-oss-120b"
        }
      }
    },
    "ollama-tablet": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "ollama tablet",
      "options": {
        "baseURL": "http://192.168.1.224:11434/v1"
      },
      "models": {
        "qwen3": {
          "name": "qwen3",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "snoop-doc": {
      "type": "remote",
      "url": "{env:SNOOP_DOC_MCP_URL}"
    },
    "jetbrains": {
      "type": "remote",
      "url": "http://127.0.0.1:64342/sse",
    },
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp"
    }
  }
}
