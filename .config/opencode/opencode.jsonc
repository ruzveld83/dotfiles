{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "@ex-machina/opencode-anthropic-auth@2.0.0-next.6",
    "@dietrichgebert/ponytail@5.3.2"
  ],
  "permissions": [
    { "action": "*", "resource": "*", "effect": "ask" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "todowrite", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "rg *", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "find *", "effect": "allow" },
    { "action": "shell", "resource": "echo *", "effect": "allow" },
    { "action": "shell", "resource": "wc *", "effect": "allow" },
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "context7_*", "resource": "*", "effect": "allow" },
    { "action": "snoop_doc_*", "resource": "*", "effect": "allow" },
    { "action": "jetbrains_read*", "resource": "*", "effect": "allow" },
    { "action": "jetbrains_search*", "resource": "*", "effect": "allow" }
  ],
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        }
      },
      "snoop-doc": {
        "type": "remote",
        "url": "{env:SNOOP_DOC_MCP_URL}"
      },
      "jetbrains": {
        "type": "remote",
        "url": "http://127.0.0.1:64342/sse"
      },
      "atlassian": {
        "type": "remote",
        "url": "https://mcp.atlassian.com/v1/mcp"
      }
    }
  }
}
