{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "@ex-machina/opencode-anthropic-auth@2.0.0-next.6",
    "@dietrichgebert/ponytail@5.3.2"
  ],
  "permissions": [
    { "action": "*", "resource": "*", "effect": "ask" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "todowrite", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "rg *", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "find *", "effect": "allow" },
    { "action": "shell", "resource": "echo *", "effect": "allow" },
    { "action": "shell", "resource": "wc *", "effect": "allow" },
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "which *", "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git rev-parse *", "effect": "allow" },
    { "action": "shell", "resource": "git ls-files *", "effect": "allow" },
    { "action": "shell", "resource": "git check-ignore *", "effect": "allow" },
    // Inspection commands can also write output files or launch external programs.
    { "action": "shell", "resource": "git *--output*", "effect": "ask" },
    { "action": "shell", "resource": "git *--ext-diff*", "effect": "ask" },
    { "action": "shell", "resource": "git *--textconv*", "effect": "ask" },
    { "action": "context7_*", "resource": "*", "effect": "allow" },
    { "action": "snoop-doc_*", "resource": "*", "effect": "allow" },
    { "action": "jetbrains_read*", "resource": "*", "effect": "allow" },
    { "action": "jetbrains_search*", "resource": "*", "effect": "allow" }
  ],
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:CONTEXT7_API_KEY}"
        }
      },
      "snoop-doc": {
        "type": "remote",
        "url": "{env:SNOOP_DOC_MCP_URL}",
        "disabled": true
      },
      "jetbrains": {
        "type": "remote",
        "url": "http://127.0.0.1:64342/sse",
        "disabled": true
      },
      "atlassian": {
        "type": "remote",
        "url": "https://mcp.atlassian.com/v2/mcp"
      }
    }
  }
}
