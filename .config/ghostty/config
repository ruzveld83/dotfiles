auto-update-channel = stable

theme = Catppuccin Frappe
font-family = Monaco
font-size = 16

# per-OS override: symlink ~/.ghostty-config -> config.macos or config.linux
# on each machine. ? = optional (missing symlink is fine). Includes are
# processed last, so this overrides font-size above regardless of position.
config-file = ?~/.ghostty-config

cursor-style = block
shell-integration-features = no-cursor,ssh-env,ssh-terminfo
macos-titlebar-style = tabs
window-colorspace = display-p3
macos-option-as-alt = true

